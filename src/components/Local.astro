---
const drawings = [
  { title: "Drawing — 20 Oct", when: "edited just now", poster: "/media/tour-thumb.webp" },
  { title: "Sprint retro", when: "edited yesterday", poster: "/media/templates.webp" },
  { title: "Sign-up flow", when: "edited 3 days ago", poster: "/media/diagram.webp" },
];
---

<section class="local" aria-labelledby="local-title">
  <div class="wrap grid">
    <div class="copy">
      <h2 id="local-title">Your drawings stay in your browser.</h2>
      <p>
        There is no account to make. Open the address and you are on a drawing. Every stroke is
        saved as you go, in this browser's own storage, so closing the tab loses nothing.
      </p>
      <ul class="points">
        <li>
          <b>Nothing leaves until you press Share.</b> A drawing you keep to yourself makes no
          request to any server.
        </li>
        <li>
          <b>My drawings</b>, in the menu, lists everything this browser holds, with a picture of
          each.
        </li>
        <li>
          <b>Save to disk</b> writes a file you can keep, move to another computer and open again.
        </li>
      </ul>
    </div>

    <figure class="gallery" aria-label="An example of the My drawings page">
      <div class="gallery-bar">
        <span class="gallery-title">My drawings</span>
        <span class="gallery-new">New drawing</span>
      </div>
      <ul class="cards">
        {drawings.map((d) => (
          <li class="card">
            <img src={d.poster} alt="" width="320" height="200" loading="lazy" decoding="async" />
            <span class="card-title">{d.title}</span>
            <span class="card-when">{d.when}</span>
          </li>
        ))}
      </ul>
      <figcaption class="note">all of this lives on your computer</figcaption>
    </figure>
  </div>
</section>

<style>
  .local {
    padding-block: clamp(72px, 11vw, 140px);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-4);
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .copy p {
    margin: 20px 0 0;
    max-width: 52ch;
    color: var(--ink-soft);
    font-size: 1.125rem;
  }
  .points {
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
    max-width: 52ch;
  }
  .points li {
    position: relative;
    padding-left: 26px;
    color: var(--ink-soft);
  }
  .points li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 12px;
    height: 7px;
    border-left: 2.5px solid var(--violet);
    border-bottom: 2.5px solid var(--violet);
    transform: rotate(-45deg);
  }
  .points b {
    color: var(--ink);
    font-weight: 600;
  }

  .gallery {
    position: relative;
    margin: 0;
    padding: 18px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid #e3e2ee;
    box-shadow: 0 30px 60px -36px rgb(27 26 46 / 0.4);
  }
  .gallery-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 2px 4px 14px;
  }
  .gallery-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
  }
  .gallery-new {
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--violet);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .card {
    display: grid;
    gap: 2px;
    padding: 8px;
    border-radius: 10px;
    border: 1px solid #ecebf4;
  }
  .card img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 6px;
    background: #f6f6fb;
    margin-bottom: 6px;
  }
  .card-title {
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-when {
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
  .note {
    position: absolute;
    right: 18px;
    bottom: -38px;
    font-family: var(--font-hand);
    font-size: 1.25rem;
    color: var(--violet);
    transform: rotate(-2deg);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cards li:nth-child(3) {
      display: none;
    }
  }
</style>
