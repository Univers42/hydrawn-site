---
import Mark from "./Mark.astro";

const faq = [
  [
    "Is it really free?",
    "Yes. There is no account, no paid plan and no advertising. It runs on free hosting, and the drawing itself happens on your computer.",
  ],
  [
    "Where are my drawings kept?",
    "In this browser's own storage, on this computer. Clearing the site's data from the browser deletes them, so use Save to disk for anything you want to keep for good.",
  ],
  [
    "Can the people who run Hydrawn see what I draw?",
    "No. A drawing you never share never leaves your browser. A shared one is encrypted in your browser with a key that only exists in the link, so the relay and the stored copy hold nothing they can read.",
  ],
  [
    "Can I take back a link I sent?",
    "Not yet. Anyone with the link can open and edit the drawing until its online copy expires, a year after the last edit. Deleting the drawing from My drawings removes only your own copy.",
  ],
  [
    "Can I run it on my own computer?",
    "Yes. The source is on GitHub, and one command starts the whole thing in Docker, with its own database and its own relay, for a team that wants to keep everything in-house.",
  ],
];
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <h2 id="faq-title">Questions people ask</h2>
    <div class="list">
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="last" aria-labelledby="last-title">
  <div class="wrap last-inner">
    <Mark size="full" class="last-mark" />
    <h2 id="last-title">Grab a pen.</h2>
    <a class="start" href="https://app.hydrawn.js.org">
      Start drawing
    </a>
    <p class="hand">it opens straight onto a blank drawing</p>
  </div>
</section>

<footer class="foot">
  <div class="wrap foot-inner">
    <a class="brand" href="/" aria-label="Hydrawn, home">
      <Mark size="small" class="foot-mark" />
      <span>Hydrawn</span>
    </a>
    <nav aria-label="Footer">
      <a href="https://app.hydrawn.js.org">The app</a>
      <a href="https://github.com/Univers42/hydrawn">Source on GitHub</a>
      <a href="/brand/">Logo and brand</a>
    </nav>
  </div>
</footer>

<style>
  .faq {
    padding-block: clamp(72px, 11vw, 140px);
    border-top: 1px solid #ecebf4;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 6vw, 88px);
    align-items: start;
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-4);
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .list {
    border-top: 1px solid #e3e2ee;
  }
  details {
    border-bottom: 1px solid #e3e2ee;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding-block: 12px;
    cursor: pointer;
    list-style: none;
    font-size: 1.125rem;
    font-weight: 600;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "";
    flex: none;
    width: 12px;
    height: 12px;
    border-right: 2.5px solid var(--violet);
    border-bottom: 2.5px solid var(--violet);
    transform: translateY(-3px) rotate(45deg);
    transition: transform 0.2s ease;
  }
  details[open] summary::after {
    transform: translateY(3px) rotate(-135deg);
  }
  details p {
    margin: 0;
    padding-bottom: 20px;
    max-width: 60ch;
    color: var(--ink-soft);
  }

  .last {
    padding-block: clamp(72px, 10vw, 128px);
    background: linear-gradient(to bottom, transparent, rgb(105 101 219 / 0.07));
  }
  .last-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 18px;
  }
  .last :global(.last-mark) {
    width: 132px;
    height: 132px;
  }
  .last h2 {
    font-size: var(--step-5);
  }
  .start {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding: 0 30px;
    border-radius: 12px;
    background: var(--violet);
    color: #fff;
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
    box-shadow:
      0 1px 0 var(--violet-deep),
      0 12px 28px -12px rgb(105 101 219 / 0.8);
    transition: background-color 0.15s ease;
  }
  .start:hover {
    background: var(--violet-deep);
  }
  .hand {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.25rem;
    color: var(--ink-soft);
  }

  .foot {
    padding-block: 28px calc(28px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid #ecebf4;
    background: var(--paper);
  }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .brand :global(.foot-mark) {
    width: 28px;
    height: 28px;
  }
  .foot nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 0.9375rem;
  }
  .foot nav a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .foot nav a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
