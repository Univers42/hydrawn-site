---
import { existsSync } from "node:fs";

interface Reel {
  clip: string;
  title: string;
  line: string;
  /** What the recording shows, for a screen reader. */
  label: string;
}

// The longer recordings, each of something hard. A reel appears once its three files are in
// public/media, so a clip still being recorded is simply not listed.
const reels: Reel[] = [
  {
    clip: "deck",
    title: "Present like Prezi",
    line: "Frames become slides. The presentation flies from one to the next and zooms into a drawing inside a drawing.",
    label:
      "A presentation flies through nested frames, zooming from a house at night into a room, a painting, an oak and a dream",
  },
  {
    clip: "photo",
    title: "A photo, turned into shapes",
    line: "Drop in a picture and vectorise it. Every piece becomes a shape you can recolour and restyle.",
    label: "A photo is vectorised into shapes, which are then recoloured one by one",
  },
  {
    clip: "diagram",
    title: "Mermaid to diagram",
    line: "Paste Mermaid text and get the whole diagram as shapes and bound arrows, then restyle it by hand.",
    label:
      "Mermaid text is imported as a diagram, recoloured, and a shape is moved while its arrows follow",
  },
  {
    clip: "notes",
    title: "Sticky notes for a team",
    line: "A retro on one board: everyone drops notes, groups them under headings by colour and marks the ones that matter.",
    label: "Several people add sticky notes to a retro board, group them by colour and mark some",
  },
  {
    clip: "depth",
    title: "Depth from flat shapes",
    line: "Perspective and isometric drawings, built from plain 2D shapes and shaded faces.",
    label: "An isometric drawing is built from flat shapes with shaded faces",
  },
].filter((r) =>
  ["mp4", "webm", "webp"].every((ext) => existsSync(`public/media/${r.clip}.${ext}`)),
);
---

{reels.length > 0 && (
  <section id="reels" class="reels" aria-labelledby="reels-title">
    <div class="wrap">
      <h2 id="reels-title">The hard things, recorded.</h2>
      <p class="lede">Real recordings of the app, nothing staged or composited.</p>
      <ol>
        {reels.map((r) => (
          <li>
            <div class="words">
              <h3>{r.title}</h3>
              <p>{r.line}</p>
            </div>
            <video
              muted
              loop
              playsinline
              preload="none"
              poster={`/media/${r.clip}.webp`}
              aria-label={r.label}
              data-inview
            >
              <source data-src={`/media/${r.clip}.webm`} type="video/webm" />
              <source data-src={`/media/${r.clip}.mp4`} type="video/mp4" />
            </video>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<style>
  .reels {
    padding-block: clamp(64px, 10vw, 128px);
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-4);
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .lede {
    margin: 22px 0 0;
    max-width: 58ch;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  ol {
    list-style: none;
    margin: clamp(40px, 6vw, 72px) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(48px, 8vw, 96px);
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
  }
  li:nth-child(even) .words {
    order: 2;
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-2);
    line-height: 1.1;
  }
  .words p {
    margin: 12px 0 0;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    background: #e3e2ee;
    box-shadow: 0 30px 60px -34px rgb(27 26 46 / 0.55);
  }
  @media (max-width: 760px) {
    li {
      grid-template-columns: minmax(0, 1fr);
    }
    li:nth-child(even) .words {
      order: 0;
    }
  }
</style>
