---
import Mark from "./Mark.astro";
import { APP_URL } from "../lib/app.ts";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="copy">
      <h1 id="hero-title">
        <span class="line">Many heads.</span>
        <span class="line second">
          One drawing.
          <svg class="underline" viewBox="0 0 420 26" preserveAspectRatio="none" aria-hidden="true">
            <path pathLength="1" d="M4 15C60 8 118 21 178 13S302 6 358 14S404 17 416 11" />
          </svg>
        </span>
      </h1>
      <p class="lede">
        A free whiteboard that runs in your browser. Share a link and draw together, end-to-end
        encrypted. No account, nothing to install.
      </p>
      <div class="actions">
        <a class="start" href={APP_URL}>
          Start drawing
        </a>
        <a class="source" href="https://github.com/Univers42/hydrawn">
          Source on GitHub
        </a>
      </div>
    </div>

    <div class="mascot">
      <Mark
        size="full"
        draw
        label="The Hydrawn hydra: three heads, each a fountain-pen nib"
        class="mascot-mark"
      />
    </div>
  </div>

  <div class="wrap stage">
    <figure class="window">
      <div class="chrome" aria-hidden="true">
        <span class="dots">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span class="address">app.hydrawn.js.org</span>
      </div>
      <video
        class="screen"
        muted
        loop
        playsinline
        preload="metadata"
        poster="/media/tour.webp"
        data-inview
        aria-label="A recording of Hydrawn: shapes, a connected arrow, a freehand line and text being drawn"
      >
        <source src="/media/tour.webm" type="video/webm" />
        <source src="/media/tour.mp4" type="video/mp4" />
      </video>
    </figure>

    <div class="peer peer-green" aria-hidden="true">
      <svg viewBox="0 0 16 16">
        <path d="M1 1L14 6.5L7.6 8L5.6 14.6Z" />
      </svg>
      <span>Ada</span>
    </div>
    <p class="note note-green">a real recording, not a mockup</p>

    <div class="peer peer-orange" aria-hidden="true">
      <svg viewBox="0 0 16 16">
        <path d="M1 1L14 6.5L7.6 8L5.6 14.6Z" />
      </svg>
      <span>Sam</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(28px, 6vw, 72px) clamp(48px, 8vw, 96px);
    overflow-x: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 300px);
    align-items: end;
    gap: clamp(16px, 4vw, 56px);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-5);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  h1 .line {
    display: block;
  }
  h1 .second {
    position: relative;
    width: fit-content;
  }

  /* Drawn once, as the hydra finishes. */
  .underline {
    position: absolute;
    left: -2%;
    bottom: -0.16em;
    width: 104%;
    height: 0.24em;
    overflow: visible;
  }
  .underline path {
    fill: none;
    stroke: var(--violet);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1.02;
    animation: underline 0.9s cubic-bezier(0.65, 0, 0.35, 1) 1.35s both;
  }
  @keyframes underline {
    to {
      stroke-dashoffset: 0;
    }
  }

  .lede {
    margin: clamp(22px, 3vw, 34px) 0 0;
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
  .start {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 26px;
    border-radius: 12px;
    background: var(--violet);
    color: #fff;
    font-weight: 600;
    font-size: 1.0625rem;
    text-decoration: none;
    box-shadow:
      0 1px 0 var(--violet-deep),
      0 10px 24px -12px rgb(105 101 219 / 0.75);
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }
  .start:hover {
    background: var(--violet-deep);
  }
  .start:active {
    transform: translateY(1px);
  }
  .source {
    font-weight: 500;
    color: var(--ink);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    text-decoration-color: var(--grid);
  }
  .source:hover {
    text-decoration-color: var(--violet);
  }

  .mascot {
    justify-self: end;
    width: 100%;
    max-width: 300px;
  }
  .mascot :global(.mascot-mark) {
    width: 100%;
    aspect-ratio: 1;
  }

  /* The app, in a browser window, with two collaborators' cursors around it. */
  .stage {
    position: relative;
    margin-top: clamp(36px, 6vw, 64px);
  }
  .window {
    margin: 0;
    border-radius: 14px;
    border: 1px solid #d9d8e6;
    background: #fff;
    overflow: hidden;
    box-shadow:
      0 1px 0 #ecebf4,
      0 30px 60px -32px rgb(27 26 46 / 0.35);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 40px;
    padding: 0 14px;
    background: #f3f3f8;
    border-bottom: 1px solid #e3e2ee;
  }
  .dots {
    display: flex;
    gap: 7px;
  }
  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #d6d5e3;
  }
  .address {
    flex: 0 1 340px;
    margin-inline: auto;
    padding: 4px 12px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid #e3e2ee;
    color: var(--ink-soft);
    font-size: 0.8125rem;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .screen {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: #fff;
  }

  .peer {
    position: absolute;
    display: flex;
    align-items: flex-start;
    gap: 2px;
    pointer-events: none;
    animation: peer-in 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .peer svg {
    width: 22px;
    height: 22px;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.25));
  }
  .peer path {
    stroke: #fff;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .peer span {
    margin-top: 16px;
    padding: 2px 9px 3px;
    border-radius: 7px;
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .peer-green {
    top: -18px;
    left: max(8px, 6%);
    animation-delay: 1.8s;
  }
  .peer-green path {
    fill: var(--peer-green);
  }
  .peer-green span {
    background: var(--peer-green-tag);
  }
  .peer-orange {
    right: max(8px, 4%);
    bottom: 14%;
    animation-delay: 2.1s;
  }
  .peer-orange path {
    fill: var(--peer-orange);
  }
  .peer-orange span {
    background: var(--peer-orange);
    color: var(--ink);
  }
  @keyframes peer-in {
    from {
      opacity: 0;
      translate: -26px -18px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .note {
    position: absolute;
    top: -46px;
    left: calc(max(8px, 6%) + 70px);
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.25rem;
    color: var(--peer-green);
    transform: rotate(-2deg);
    animation: peer-in 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 2s both;
  }

  @media (max-width: 760px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .mascot {
      order: -1;
      justify-self: start;
      max-width: 128px;
    }
    .note {
      display: none;
    }
    .peer-orange {
      bottom: 6%;
    }
  }
</style>
