---
interface Clip {
  clip: string;
  title: string;
  line: string;
  /** What the recording shows, for a screen reader; the title when absent. */
  label?: string;
}

/** The longer recordings, each of something hard, shown large. */
const reels: Clip[] = [
  {
    clip: "photo",
    title: "A photo, turned into shapes",
    line: "Drop in a photo and vectorise it: it becomes about a hundred shapes, each one yours to recolour and restyle.",
    label:
      "A photo of a red panda is vectorised into 99 shapes; the background and a branch are recoloured and a title is added",
  },
  {
    clip: "deck",
    title: "Present like Prezi",
    line: "Frames become slides. The presentation flies from one to the next and zooms into a drawing inside a drawing.",
    label:
      "An eleven-slide presentation flies between frames and zooms into drawings inside drawings, from a house at night to a treehouse",
  },
  {
    clip: "diagram",
    title: "Mermaid to diagram",
    line: "Paste Mermaid text and get the whole diagram as shapes and bound arrows, then restyle it by hand.",
    label:
      "Mermaid text is imported as a diagram, recoloured, and a shape is moved while its arrows follow",
  },
  {
    clip: "notes",
    title: "Sticky notes for a team",
    line: "A retro on one board: everyone drops notes, groups them under headings by colour and marks the ones that matter.",
    label:
      "Four people fill a retro board with sticky notes under three headings, group them and vote on them",
  },
];

/** The shorter ones, side by side. */
const tiles: Clip[] = [
  {
    clip: "arrows",
    title: "Arrows that stay attached",
    line: "Draw an arrow from one shape to another and it holds on. Move either shape and the arrow follows.",
  },
  {
    clip: "templates",
    title: "Start from a template",
    line: "A retro, a mind map, a pitch, an architecture sketch or a checkout flow.",
  },
];

const extras = [
  ["Export", "PNG files, or a picture straight to the clipboard."],
  ["Command palette", "Every action, searchable, with its shortcut beside it."],
  ["Frames and groups", "Keep parts of a big board together and move them as one."],
];
---

<section id="features" class="features" aria-labelledby="features-title">
  <div class="wrap">
    <h2 id="features-title">Everything you reach for on a whiteboard.</h2>
    <p class="lede">
      The drawing engine is written in Rust and runs in your browser as WebAssembly, so a busy board
      stays quick. These are real recordings of the app.
    </p>

    <ol class="reels">
      {reels.map((r) => (
        <li>
          <div class="words">
            <h3>{r.title}</h3>
            <p>{r.line}</p>
          </div>
          <div class="clip">
            <video
              muted
              loop
              playsinline
              preload="none"
              poster={`/media/${r.clip}.webp`}
              aria-label={r.label ?? r.title}
              data-inview
            >
              <source data-src={`/media/${r.clip}.webm`} type="video/webm" />
              <source data-src={`/media/${r.clip}.mp4`} type="video/mp4" />
            </video>
          </div>
        </li>
      ))}
    </ol>

    <ul class="bento">
      {tiles.map((t) => (
        <li class="tile">
          <div class="clip">
            <video
              muted
              loop
              playsinline
              preload="none"
              poster={`/media/${t.clip}.webp`}
              aria-label={t.title}
              data-inview
            >
              <source data-src={`/media/${t.clip}.webm`} type="video/webm" />
              <source data-src={`/media/${t.clip}.mp4`} type="video/mp4" />
            </video>
          </div>
          <h3>{t.title}</h3>
          <p>{t.line}</p>
        </li>
      ))}
    </ul>

    <dl class="extras">
      {extras.map(([title, line]) => (
        <div>
          <dt>{title}</dt>
          <dd>{line}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .features {
    padding-block: clamp(72px, 11vw, 140px);
    border-top: 1px solid #ecebf4;
  }
  h2 {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-4);
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .lede {
    margin: 20px 0 0;
    max-width: 56ch;
    font-size: 1.125rem;
    color: var(--ink-soft);
  }

  .reels {
    margin: clamp(40px, 6vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: clamp(40px, 7vw, 88px);
  }
  .reels li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
  }
  .reels li:nth-child(even) .words {
    order: 2;
  }
  .reels h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-2);
    line-height: 1.1;
  }
  .reels p {
    margin: 12px 0 0;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .reels .clip {
    margin: 0;
  }

  .bento {
    margin: clamp(48px, 8vw, 96px) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .tile {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 6px;
  }
  .clip {
    margin-bottom: 10px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #e3e2ee;
    background: #fff;
    box-shadow: 0 20px 40px -30px rgb(27 26 46 / 0.45);
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: #fff;
  }
  h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .tile p {
    margin: 0;
    max-width: 46ch;
    color: var(--ink-soft);
    font-size: 0.9875rem;
    line-height: 1.55;
  }

  .extras {
    margin: clamp(40px, 6vw, 64px) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px clamp(24px, 4vw, 48px);
  }
  .extras div {
    border-top: 1px solid #e3e2ee;
    padding-top: 14px;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 4px 0 0;
    color: var(--ink-soft);
    font-size: 0.9875rem;
  }

  @media (max-width: 760px) {
    .reels li {
      grid-template-columns: minmax(0, 1fr);
    }
    .reels li:nth-child(even) .words {
      order: 0;
    }
  }
  @media (max-width: 560px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
