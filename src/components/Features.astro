---
interface Tile {
  clip: string;
  title: string;
  line: string;
  size: "wide" | "half" | "third";
  /** Cut tall to stand as high as the wide tile beside it. */
  tall?: boolean;
}

const tiles: Tile[] = [
  {
    clip: "arrows",
    title: "Arrows that stay attached",
    line: "Draw an arrow from one shape to another and it holds on. Move either shape and the arrow follows.",
    size: "wide",
  },
  {
    clip: "sticky",
    title: "Sticky notes",
    line: "Drop a note, type on it, and it grows to fit what you wrote.",
    size: "third",
    tall: true,
  },
  {
    clip: "mermaid",
    title: "Mermaid to diagram",
    line: "Paste a Mermaid flowchart and it lands on the board as shapes and arrows you can edit.",
    size: "half",
  },
  {
    clip: "vectorize",
    title: "Trace a picture",
    line: "Right-click an image and turn it into editable shapes.",
    size: "half",
  },
  {
    clip: "present",
    title: "Present with a laser",
    line: "Walk through the board frame by frame, pointing as you go.",
    size: "half",
  },
  {
    clip: "templates",
    title: "Start from a template",
    line: "A retro, a mind map, a pitch, an architecture sketch or a checkout flow.",
    size: "half",
  },
];

const extras = [
  ["Export", "PNG files, or a picture straight to the clipboard."],
  ["Command palette", "Every action, searchable, with its shortcut beside it."],
  ["Frames and groups", "Keep parts of a big board together and move them as one."],
];
---

<section id="features" class="features" aria-labelledby="features-title">
  <div class="wrap">
    <h2 id="features-title">Everything you reach for on a whiteboard.</h2>
    <p class="lede">
      The drawing engine is written in Rust and runs in your browser as WebAssembly, so a busy board
      stays quick. These are real recordings of the app.
    </p>

    <ul class="bento">
      {tiles.map((t) => (
        <li class:list={["tile", t.size, { tall: t.tall }]}>
          <div class="clip">
            <video
              muted
              loop
              playsinline
              preload="none"
              poster={`/media/${t.clip}.webp`}
              aria-label={t.title}
              data-inview
            >
              <source src={`/media/${t.clip}.webm`} type="video/webm" />
              <source src={`/media/${t.clip}.mp4`} type="video/mp4" />
            </video>
          </div>
          <h3>{t.title}</h3>
          <p>{t.line}</p>
        </li>
      ))}
    </ul>

    <dl class="extras">
      {extras.map(([title, line]) => (
        <div>
          <dt>{title}</dt>
          <dd>{line}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .features {
    padding-block: clamp(72px, 11vw, 140px);
    border-top: 1px solid #ecebf4;
  }
  h2 {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-4);
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .lede {
    margin: 20px 0 0;
    max-width: 56ch;
    font-size: 1.125rem;
    color: var(--ink-soft);
  }

  .bento {
    margin: clamp(40px, 6vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 20px;
  }
  .tile {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 6px;
  }
  .wide {
    grid-column: span 4;
  }
  .third {
    grid-column: span 2;
  }
  .half {
    grid-column: span 3;
  }
  .clip {
    margin-bottom: 10px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #e3e2ee;
    background: #fff;
    box-shadow: 0 20px 40px -30px rgb(27 26 46 / 0.45);
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: #fff;
  }
  /* 7:9 beside a 16:10 tile twice its width ends level with it, within a pixel or two. */
  .tall video {
    aspect-ratio: 7 / 9;
  }
  h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .tile p {
    margin: 0;
    max-width: 46ch;
    color: var(--ink-soft);
    font-size: 0.9875rem;
    line-height: 1.55;
  }

  .extras {
    margin: clamp(40px, 6vw, 64px) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px clamp(24px, 4vw, 48px);
  }
  .extras div {
    border-top: 1px solid #e3e2ee;
    padding-top: 14px;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 4px 0 0;
    color: var(--ink-soft);
    font-size: 0.9875rem;
  }

  @media (max-width: 900px) {
    .wide,
    .half,
    .third {
      grid-column: span 3;
    }
    .wide {
      grid-column: span 6;
    }
    .tall video {
      aspect-ratio: 16 / 10;
    }
  }
  @media (max-width: 560px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
    .wide,
    .half,
    .third {
      grid-column: auto;
    }
  }
</style>
